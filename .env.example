# Cloud Exam Trainer
# Copia este archivo como .env y ajusta los valores si son necesarios.
# No incluir secretos ni credenciales en el repositorio.

VITE_APP_TITLE=Cloud Exam Trainer

# Configuración del contexto de persistencia (adaptación de US-040 al MVP).
# Valores posibles: memory://default | localstorage://<namespace>
VITE_DATA_SOURCE_URL=memory://default
VITE_DATA_SCHEMA_VERSION=1.0.0
# Convención de nombres para claves de almacenamiento: snake_case | camelCase
VITE_DATA_NAMING_CONVENTION=snake_case
# No aplicar migraciones automáticamente en producción
VITE_DATA_AUTO_MIGRATE=false

# PostgreSQL (Feature 01.10 post-MVP; no se utiliza en el MVP actual)
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_exam_trainer
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cloud_exam_trainer
