{
  "openapi": "3.0.3",
  "info": {
    "title": "Cloud Exam Trainer API",
    "description": "API for managing certifications, questions and quizzes.",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Local static API"
    }
  ],
  "paths": {
    "/certifications": {
      "get": {
        "summary": "List available certifications",
        "description": "Returns all active certifications ordered by name ascending.",
        "operationId": "getCertifications",
        "responses": {
          "200": {
            "description": "List of active certifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CertificationListItemDto"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/certifications/{id}": {
      "get": {
        "summary": "Get certification by id",
        "description": "Returns an active certification by its identifier.",
        "operationId": "getCertificationById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Certification detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificationDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Certification not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/certifications/code/{code}": {
      "get": {
        "summary": "Get certification by code",
        "description": "Returns an active certification by its unique code.",
        "operationId": "getCertificationByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Certification detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificationDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Certification not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/quiz-sessions": {
      "post": {
        "summary": "Start a quiz session",
        "description": "Creates a quiz session for the selected certification and optional topic. Validates that the certification exists and is active and that the topic belongs to the certification when provided.",
        "operationId": "startQuizSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartQuizSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quiz session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizSessionDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Certification not found or inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "422": {
            "description": "Topic does not belong to the certification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error or not enough questions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/questions": {
      "get": {
        "summary": "List questions",
        "description": "Returns a paginated list of active questions ordered by updated date descending and id ascending.",
        "operationId": "listQuestions",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "certificationExamId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "examDomainId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["single_choice", "multiple_choice"]
            }
          },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["easy", "medium", "hard"]
            }
          },
          {
            "name": "isActive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "searchText",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "createdFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "createdTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["id", "statement", "type", "difficulty", "status", "createdAt", "updatedAt"]
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of questions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a question",
        "description": "Creates a new question in the question bank. Validates that the exam exists, that the domain and topic belong to the selected exam when provided, and that the answer options satisfy the rules for the selected question type.",
        "operationId": "createQuestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuestionCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateQuestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Exam or category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{id}": {
      "get": {
        "summary": "Get question by id",
        "description": "Returns the full detail of a question by its identifier, including answer options in display order.",
        "operationId": "getQuestionById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Question not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change question status",
        "description": "Activates or deactivates a question. When activating, the question structure, options and cross-references are validated.",
        "operationId": "changeQuestionStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeQuestionStatusCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question status changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeQuestionStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Activation validation failed or invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Question not found or archived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Functional conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete question",
        "description": "Logically deletes a question by setting its status to archived and marking it as inactive. The question and its options are not physically removed.",
        "operationId": "deleteQuestion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteQuestionResponse"
                }
              }
            }
          },
          "204": {
            "description": "Question deleted without response body"
          },
          "400": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Question not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Functional conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a question",
        "description": "Updates an existing question in the question bank. The question id is preserved, the creation date is preserved and the modification timestamp is updated in UTC. Options are replaced atomically.",
        "operationId": "updateQuestion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateQuestionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateQuestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Question, exam or category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Concurrency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Duplicate a question",
        "description": "Creates a new inactive draft copy of an existing question with new ids for the question and its options. The source question is not modified.",
        "operationId": "duplicateQuestion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuplicateQuestionCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question duplicated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateQuestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Source question not found or archived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Functional conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/attempt-results": {
      "post": {
        "summary": "Create an attempt result",
        "description": "Creates a result for a completed quiz session. The certification is resolved from the validated source and cannot be altered by the caller.",
        "operationId": "createAttemptResult",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizSessionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attempt result created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid session or missing certification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Certification not found or inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "CertificationListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderSummaryDto"
          }
        },
        "required": ["id", "code", "name", "description", "version", "difficulty", "imageUrl", "isActive", "provider"]
      },
      "CertificationDetailDto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CertificationListItemDto"
          }
        ]
      },
      "StartQuizSessionRequest": {
        "type": "object",
        "properties": {
          "certificationExamId": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["certificationExamId", "count"]
      },
      "QuizSessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "certificationExamId": {
            "type": "string"
          },
          "questionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentIndex": {
            "type": "integer"
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "completed"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "topic", "certificationExamId", "questionIds", "currentIndex", "answers", "status", "startedAt"]
      },
      "TopicResultDto": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "correctCount": {
            "type": "integer"
          },
          "totalQuestions": {
            "type": "integer"
          },
          "percentage": {
            "type": "integer"
          },
          "classification": {
            "type": "string",
            "enum": ["high_attention", "needs_review", "good_level", "mastered"]
          }
        },
        "required": ["topic", "correctCount", "totalQuestions", "percentage", "classification"]
      },
      "QuizResultDto": {
        "type": "object",
        "properties": {
          "correctCount": {
            "type": "integer"
          },
          "incorrectCount": {
            "type": "integer"
          },
          "percentage": {
            "type": "integer"
          },
          "totalQuestions": {
            "type": "integer"
          }
        },
        "required": ["correctCount", "incorrectCount", "percentage", "totalQuestions"]
      },
      "CertificationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderSummaryDto"
          }
        },
        "required": ["id", "code", "name", "provider"]
      },
      "AttemptResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/QuizSessionDto"
          },
          "certification": {
            "$ref": "#/components/schemas/CertificationSummaryDto"
          },
